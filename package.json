{
  "name": "hono-bun",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "bunx --bun prisma generate",
    "db:migration:generate": "bunx --bun prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script --output migrations/0001_init.sql",
    "d1:migrate:local": "wrangler d1 migrations apply hono-agent-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply hono-agent-db --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@prisma/adapter-d1": "7.6.0",
    "@prisma/client": "7.6.0",
    "hono": "^4.12.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260603.1",
    "@types/bun": "^1.4.2",
    "prisma": "7.6.0",
    "wrangler": "^4.0.0"
  }
}
