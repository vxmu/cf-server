{
  "name": "hono-bun",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "bunx --bun prisma generate",
    "db:migration:generate": "bunx --bun prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script --output migrations/0001_init.sql",
    "d1:migrate:local": "wrangler d1 migrations apply hono-agent-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply hono-agent-db --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@prisma/adapter-d1": "7.10.0",
    "@prisma/client": "7.10.0",
    "hono": "^4.13.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/bun": "^1.4.2",
    "prisma": "7.10.0",
    "wrangler": "^4.131.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.7",
    "mysql2": "3.24.4"
  }
}
