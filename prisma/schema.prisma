generator client {
  provider = "prisma-client-js"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  USER
  ADMIN
}

enum UserPlan {
  FREE
  PRO
  MAX
}

enum UserStatus {
  NORMAL
  DISABLED
  DELETED
}

model User {
  id          Int        @id @default(autoincrement())
  avatar      String?
  username    String     @unique
  nickname    String?
  password    String
  email       String?    @unique
  phone       String?    @unique
  status      UserStatus @default(NORMAL)
  plan        UserPlan   @default(FREE)
  // D1/SQLite 不支持 Prisma Decimal，这里使用 REAL 存储余额。
  balance     Float?     @default(0)
  planEndTime DateTime?  @map("plan_end_time")
  role        UserRole   @default(USER)
  createdAt   DateTime?  @default(now()) @map("created_at")
  updatedAt   DateTime?  @default(now()) @updatedAt @map("updated_at")
  profile     Json?

  @@index([status], map: "user_status_idx")
  @@index([createdAt], map: "user_created_idx")
  @@index([plan, planEndTime], map: "user_plan_time_idx")
  @@map("users")
}
